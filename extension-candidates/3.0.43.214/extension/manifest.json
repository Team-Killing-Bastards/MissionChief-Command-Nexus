      "matches": [
        "https://www.missionchief.co.uk/*",
        "https://police.missionchief.co.uk/*"
      ],
      "js": [
        "nexus-station-profiles-store.js",
        "nexus-station-profiles-data.js",
        "nexus-station-profiles-core.js",
        "nexus-station-profiles-ui.js",
        "nexus-staging-profiles-editor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
